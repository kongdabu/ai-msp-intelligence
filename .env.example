# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_ARTICLE_ANALYSIS_PER_RUN=5
GEMINI_RADAR_ANALYSIS_PER_RUN=3

# 운영 환경의 변경 API 보호 및 수동 작업 요청 제한
API_SECRET_TOKEN=
MANUAL_JOB_RATE_LIMIT_PER_MINUTE=5
CRAWL_OFFICIAL_SITE_MAX_CANDIDATES_PER_SOURCE=50

# Supabase PostgreSQL (prod 프로파일 사용 시 필수)
# Supabase 대시보드 > Settings > Database > Connection string (JDBC)
DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=
