# Phase 1 Spring Boot 백엔드 주소
MCP_API_BASE_URL=http://localhost:8080

# Spring 백엔드의 API_SECRET_TOKEN과 같은 값
MCP_API_TOKEN=replace-with-backend-api-secret-token

# MCP 클라이언트가 Authorization: Bearer 헤더로 보낼 별도 난수 토큰
MCP_SERVER_TOKEN=replace-with-a-long-random-mcp-server-token

# 선택값. Render는 자동으로 PORT를 주입한다.
PORT=3001
